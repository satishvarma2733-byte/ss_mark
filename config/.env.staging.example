# STAGING template - variable NAMES only. No staging project exists yet; nothing here is provisioned.
# Values live in the hosting provider's secret store (owner-controlled), never in this repository.
# Staging must use its own Supabase project, payment test mode, web origin, app identifiers and email recipient allowlist
# (docs/02-TRD.md section 7). Keep APP_MODE=mock until sandbox provider accounts are approved.
APP_ENV=staging
APP_MODE=mock
PAYMENT_PROVIDER=mock
EMAIL_PROVIDER=mock
MAPS_PROVIDER=mock
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server and worker only:
SUPABASE_SECRET_KEY=
DATABASE_URL=
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
EMAIL_API_KEY=
MAPS_SERVER_API_KEY=
WORKER_AUTH_SECRET=
OBSERVABILITY_DSN=
# Native preview builds read these at build time (eas.json "preview" profile sets APP_VARIANT=preview):
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
