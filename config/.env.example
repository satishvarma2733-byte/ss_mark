# Names only; create per-app local files during M1. Never commit real values.
APP_ENV=development
APP_MODE=mock
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server and worker only; authorize explicitly because service credentials bypass RLS.
SUPABASE_SECRET_KEY=
DATABASE_URL=
PAYMENT_PROVIDER=mock
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
# LOCAL development only (generated by pnpm env:local): the mock payment gateway and its secrets. Never set in a hosted environment.
MOCK_GATEWAY_ENABLED=
MOCK_GATEWAY_KEY_ID=
MOCK_GATEWAY_KEY_SECRET=
MOCK_GATEWAY_WEBHOOK_SECRET=
# Server-only secret that derives arrival QR tokens and PINs (rotation invalidates issued codes).
ARRIVAL_CODE_SECRET=
EMAIL_PROVIDER=mock
MAPS_PROVIDER=mock
EMAIL_API_KEY=
MAPS_SERVER_API_KEY=
# Restricted public map keys; domain/app restriction required.
NEXT_PUBLIC_MAPS_BROWSER_KEY=
EXPO_PUBLIC_MAPS_KEY=
WORKER_AUTH_SECRET=
OBSERVABILITY_DSN=
# Public-prefixed variables are client bundled and MUST NOT contain secrets.
# Apple/Google/EAS signing credentials stay in their service secret stores.
# Product owner owns accounts; technical lead manages scoped configuration/rotation.
