{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "APP_VARIANT": "development", "APP_MODE": "mock" }
    },
    "preview": {
      "distribution": "internal",
      "env": { "APP_VARIANT": "preview", "APP_MODE": "mock" }
    }
  },
  "submit": {}
}
